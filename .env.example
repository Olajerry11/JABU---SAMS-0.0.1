# =============================================================================
# JABU-SAMS Environment Variable Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =============================================================================

# --- Flask Core ---
FLASK_APP=run.py
FLASK_ENV=development          # Change to 'production' for live deployment
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# --- PostgreSQL Database ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://jabu_user:jabu_password@localhost:5432/jabu_sams_db

# --- JWT Authentication ---
JWT_SECRET_KEY=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING
# Token expiry in minutes (access token = short, refresh = long-lived)
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# --- Admin Panel ---
# Protect the Flask-Admin panel with a basic secret path prefix
ADMIN_URL_PREFIX=/sams-admin
