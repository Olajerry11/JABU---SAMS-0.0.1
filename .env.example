# =============================================================================
# JABU-SAMS Environment Variable Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =============================================================================

# --- Flask Core ---
FLASK_APP=run.py
FLASK_ENV=development          # Change to 'production' for live deployment
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# --- PostgreSQL Database ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://jabu_user:jabu_password@localhost:5432/jabu_sams_db

# --- JWT Authentication ---
JWT_SECRET_KEY=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING
# Token expiry in minutes (access token = short, refresh = long-lived)
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# --- Admin Panel ---
# Protect the Flask-Admin panel with a basic secret path prefix
ADMIN_URL_PREFIX=/sams-admin

# =============================================================================
# Phase 2: Async Sync Engine (Redis + Celery)
# =============================================================================

# --- Redis Message Broker & Result Backend ---
# Format: redis://:PASSWORD@HOST:PORT/DB_NUMBER
# DB 0 = task broker queue | DB 1 = result backend (optional separation)
# For local development (no password):
REDIS_URL=redis://localhost:6379/0

# --- Celery / Sync Engine Settings ---
# Maximum number of scan events allowed in a single /sync/upload request.
# Tablets with larger queues must chunk them into multiple requests.
SYNC_MAX_BATCH_SIZE=1000

# --- CORS Allowed Origins ---
# Comma-separated list of allowed origins for API access.
# Use * for development. Restrict to specific domains in production.
# Example: https://jabu-sams.admin.ng,app://jabu-sams-flutter
CORS_ORIGINS=*
